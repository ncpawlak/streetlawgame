extends Node3D
## Walkable lot for the vehicle kit (scenes/vehicles/). Every registry vehicle sits on a labelled pad
## along the central aisle; walk up, press E to drive, take it round the test loop (with a ramp) and
## press E to get out. F5 puts every vehicle back on its pad with a fresh paint job.
## Generated by tools/vehicles/build_vehicles.py, but the scene itself is plain and editable.
## Esc releases the mouse, a click recaptures it.

const RESET_KEY := KEY_F5

@export var paint_seed := 1
@export var capture_mouse := true

var _reset_count := 0


func _ready() -> void:
	_build_environment()
	spawn_all()
	var help := Label.new()
	help.text = "VEHICLE SHOWCASE   E enter/exit   WASD drive   Space handbrake   F5 reset all   Esc mouse"
	help.position = Vector2(16.0, 12.0)
	help.add_theme_color_override("font_outline_color", Color.BLACK)
	help.add_theme_constant_override("outline_size", 6)
	var layer := CanvasLayer.new()
	layer.add_child(help)
	add_child(layer)
	if capture_mouse and DisplayServer.get_name() != "headless":
		Input.mouse_mode = Input.MOUSE_MODE_CAPTURED


func _input(event: InputEvent) -> void:
	if event is InputEventKey and event.pressed and not event.echo and (event as InputEventKey).keycode == RESET_KEY:
		reset_all()
		get_viewport().set_input_as_handled()
	elif event.is_action_pressed("ui_cancel"):
		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
	elif event is InputEventMouseButton and event.pressed and Input.mouse_mode != Input.MOUSE_MODE_CAPTURED:
		Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
		get_viewport().set_input_as_handled()


## Pad spawn markers, one per registry vehicle.
func spawn_points() -> Array[Marker3D]:
	var result: Array[Marker3D] = []
	for pad in $Pads.get_children():
		var marker := pad.get_node_or_null("Spawn") as Marker3D
		if marker != null and marker.has_meta("vehicle_id"):
			result.append(marker)
	return result


func vehicles() -> Array[Node]:
	return $Vehicles.get_children()


func spawn_all() -> void:
	var index := 0
	for marker in spawn_points():
		var id := StringName(marker.get_meta("vehicle_id"))
		var node := VehicleCatalog.instantiate(id, paint_seed * 1000 + _reset_count * 100 + index)
		index += 1
		if node == null:
			continue
		node.transform = ($Vehicles as Node3D).global_transform.affine_inverse() * marker.global_transform.translated(Vector3.UP * 0.25)
		$Vehicles.add_child(node)


## Gets the player out, frees every vehicle and spawns the line-up again with new paint.
func reset_all() -> void:
	var player := get_node_or_null("Player") as Player
	if player != null and player.current_vehicle != null:
		player.current_vehicle.exit_seat(player)
	elif player != null:
		player.cancel_moves()
	for node in vehicles():
		$Vehicles.remove_child(node)
		node.queue_free()
	_reset_count += 1
	spawn_all()
	EventBus.notify.emit("All vehicles reset")


func _build_environment() -> void:
	var sky_material := ProceduralSkyMaterial.new()
	sky_material.sky_top_color = Color(0.35, 0.5, 0.75)
	sky_material.sky_horizon_color = Color(0.8, 0.65, 0.55)
	var sky := Sky.new()
	sky.sky_material = sky_material
	var environment := Environment.new()
	environment.background_mode = Environment.BG_SKY
	environment.sky = sky
	environment.ambient_light_source = Environment.AMBIENT_SOURCE_SKY
	environment.tonemap_mode = Environment.TONE_MAPPER_FILMIC
	environment.fog_enabled = true
	environment.fog_density = 0.002
	environment.fog_light_color = Color(0.75, 0.65, 0.6)
	var world_environment := WorldEnvironment.new()
	world_environment.environment = environment
	add_child(world_environment)
	var sun := DirectionalLight3D.new()
	sun.rotation_degrees = Vector3(-50.0, -30.0, 0.0)
	sun.light_energy = 1.1
	sun.shadow_enabled = true
	sun.directional_shadow_max_distance = 160.0
	add_child(sun)
