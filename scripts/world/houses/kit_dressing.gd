class_name KitDressing
extends RefCounted
## Seeded West Palm Beach dressing for a building-kit scene (houses, businesses, census buildings,
## CSG or baked): palms, brush, flower beds, yard clutter, window units / bars / storm panels and
## wall wear, picked per income tier from data/buildings/kit_dressing.json (generated by
## tools/houses/props.py) and placed around the building with the dress_* metadata the generator
## writes on the scene root (lot-space solids, paving, blocked areas, walls and openings).
##
## Output is one internal "Dressing" child: a MultiMeshInstance3D per (mesh, material) of the
## low-poly prop scenes in scenes/props/, plus a single StaticBody3D holding the collision of the
## props that have it (trunks, poles, fences, bins, pools - never brush, flowers or decals).
## Seed 0 removes the dressing. Apply after KitVariant; pass mirrored so it follows the building.

const RULES := "res://data/buildings/kit_dressing.json"
const NODE_NAME := "Dressing"
const ATTEMPTS := 14
const TREE_CATEGORIES := ["palms", "trees"]
const SPIN_CATEGORIES := ["palms", "trees", "shrubs", "ground"]

static var _tiers := {}
static var _props := {}


## Rebuilds the dressing on [param root]. [param tier] "auto" uses the root's dress_tier
## metadata. Returns the Dressing node (null when the seed is 0 or the scene has no metadata).
static func apply(root: Node3D, dress_seed: int, tier := "auto", mirrored := false) -> Node3D:
	clear(root)
	if dress_seed == 0 or not root.has_meta("dress_solids"):
		return null
	var t := tier
	if t == "auto" or t.is_empty():
		t = String(root.get_meta("dress_tier", "medium"))
	var rules: Array = tiers().get(t, [])
	var lot: Vector2 = root.get("lot_size") if "lot_size" in root else Vector2(20, 30)
	var ctx := _Context.new(root, lot)
	var rng := RandomNumberGenerator.new()
	rng.seed = hash("%d:%s" % [dress_seed, t])
	for rule: Dictionary in rules:
		if rule.has("chance") and rng.randf() > float(rule["chance"]):
			continue
		var count: Array = rule.get("count", [1, 1])
		var n := rng.randi_range(int(count[0]), int(count[1]))
		for i in n:
			if not _place(ctx, rule, rng) and rule.has("alt_scene"):
				var alt := rule.duplicate()
				alt["scene"] = rule["alt_scene"]
				_place(ctx, alt, rng)
	if ctx.items.is_empty():
		return null
	var node := _build(ctx.items, mirrored)
	node.set_meta("tier", t)
	root.add_child(node, false, Node.INTERNAL_MODE_BACK)
	return node


static func clear(root: Node) -> void:
	for child in root.get_children(true):
		if child.name == NODE_NAME:
			root.remove_child(child)
			child.free()


static func tiers() -> Dictionary:
	if _tiers.is_empty():
		var data: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(RULES))
		_tiers = data["tiers"]
	return _tiers


## Cached mesh parts / collision shapes / footprints of one prop scene.
static func prop_info(path: String) -> Dictionary:
	if _props.has(path):
		return _props[path]
	var inst := (load(path) as PackedScene).instantiate() as Node3D
	var info := {"parts": [], "shapes": [], "category": String(inst.get("category")),
			"mount": String(inst.get("mount")), "id": String(inst.get("prop_id"))}
	var box := AABB()
	var trunk := AABB()
	var first := [true, true]
	_walk(inst, Transform3D.IDENTITY, info, func(b: AABB, solid: bool) -> void:
		var k := 1 if solid else 0
		if first[k]:
			first[k] = false
			if solid:
				trunk = b
			else:
				box = b
		elif solid:
			trunk = trunk.merge(b)
		else:
			box = box.merge(b))
	inst.free()
	info["parts"] = _merge_parts(info["parts"])
	info["aabb"] = box
	info["foot"] = Rect2(box.position.x, box.position.z, box.size.x, box.size.z)
	info["trunk"] = Rect2(trunk.position.x, trunk.position.z, trunk.size.x, trunk.size.z) \
			if not first[1] else info["foot"]
	_props[path] = info
	return info


## One merged mesh per material, so each placed prop costs one MultiMesh instance per material.
static func _merge_parts(parts: Array) -> Array:
	var tools := {}
	for part: Array in parts:
		var st: SurfaceTool = tools.get(part[1])
		if st == null:
			st = SurfaceTool.new()
			tools[part[1]] = st
		var mesh: Mesh = part[0]
		for s in mesh.get_surface_count():
			st.append_from(mesh, s, part[2])
	var out := []
	for material: Material in tools:
		out.append([(tools[material] as SurfaceTool).commit(), material, Transform3D.IDENTITY])
	return out


static func _walk(node: Node, xf: Transform3D, info: Dictionary, grow: Callable) -> void:
	for child in node.get_children():
		if not child is Node3D:
			continue
		var t: Transform3D = xf * (child as Node3D).transform
		if child is MeshInstance3D and child.mesh:
			info["parts"].append([child.mesh, child.material_override, t])
			grow.call(t * child.mesh.get_aabb(), false)
		elif child is CollisionShape3D and child.shape:
			info["shapes"].append([child.shape, t])
			grow.call(t * child.shape.get_debug_mesh().get_aabb(), true)
		if child is StaticBody3D or child is Node3D and not child is Label3D:
			_walk(child, t, info, grow)


class _Context:
	var lot: Rect2
	var solids: Array[Rect2] = []
	var paved: Array[Rect2] = []
	var blocked: Array[Rect2] = []
	var walls := PackedFloat32Array()
	var openings := PackedFloat32Array()
	var placed: Array[Rect2] = []
	var wall_spots: Array[Vector3] = []
	var used_windows := {}
	var items: Array = []
	var front_z := 0.0
	var back_z := 0.0
	var side_x0 := 0.0
	var side_x1 := 0.0

	func _init(root: Node3D, lot_size: Vector2) -> void:
		lot = Rect2(-lot_size.x * 0.5, -lot_size.y, lot_size.x, lot_size.y)
		solids = _rects(root.get_meta("dress_solids", PackedVector4Array()))
		paved = _rects(root.get_meta("dress_paved", PackedVector4Array()))
		blocked = _rects(root.get_meta("dress_blocked", PackedVector4Array()))
		walls = root.get_meta("dress_walls", PackedFloat32Array())
		openings = root.get_meta("dress_openings", PackedFloat32Array())
		front_z = lot.position.y
		back_z = 0.0
		side_x0 = 0.0
		side_x1 = 0.0
		for r in solids:
			front_z = maxf(front_z, r.end.y)
			back_z = minf(back_z, r.position.y)
			side_x0 = minf(side_x0, r.position.x)
			side_x1 = maxf(side_x1, r.end.x)

	static func _rects(values: PackedVector4Array) -> Array[Rect2]:
		var out: Array[Rect2] = []
		for v in values:
			out.append(Rect2(v.x, v.y, v.z - v.x, v.w - v.y).abs())
		return out


static func _place(ctx: _Context, rule: Dictionary, rng: RandomNumberGenerator) -> bool:
	var info := prop_info(String(rule["scene"]))
	var zone := String(rule["zone"])
	for attempt in ATTEMPTS:
		var xf: Variant = null
		match zone:
			"wall", "wall_any":
				xf = _wall_spot(ctx, rule, info, rng, zone == "wall")
			"window":
				xf = _window_spot(ctx, rule, info, rng)
			"back_attach":
				xf = _back_attach(ctx, rule, info)
				if xf == null:
					return false
			_:
				xf = _ground_spot(ctx, rule, info, rng, zone)
		if xf != null:
			ctx.items.append({"scene": rule["scene"], "transform": xf, "info": info,
					"rect": _ground_rect(info, xf) if info["mount"] in ["ground", "bed"] else Rect2()})
			return true
	return false


## Footprint (trunk for palms / trees) of a placed ground prop, lot-space XZ.
static func _ground_rect(info: Dictionary, xf: Transform3D) -> Rect2:
	var r: Rect2 = info["trunk"] if info["category"] in TREE_CATEGORIES else info["foot"]
	return _xf_rect(r, xf)


static func _xf_rect(r: Rect2, xf: Transform3D) -> Rect2:
	var out := Rect2()
	for i in 4:
		var c := Vector3(r.position.x + r.size.x * (i % 2), 0, r.position.y + r.size.y * (i / 2))
		var p := xf * c
		if i == 0:
			out = Rect2(p.x, p.z, 0, 0)
		else:
			out = out.expand(Vector2(p.x, p.z))
	return out


static func _shrink(r: Rect2, by: float) -> Rect2:
	var g := r.grow(by)
	return g if g.size.x > 0.0 and g.size.y > 0.0 else Rect2(r.get_center(), Vector2.ZERO)


static func _hits(r: Rect2, rects: Array[Rect2]) -> bool:
	for o in rects:
		if r.intersects(o):
			return true
	return false


static func _ground_ok(ctx: _Context, info: Dictionary, xf: Transform3D, overlap: bool) -> bool:
	var foot := _xf_rect(info["foot"], xf)
	var tree: bool = info["category"] in TREE_CATEGORIES
	var core := _ground_rect(info, xf)
	if not ctx.lot.grow(0.01).encloses(core if tree else foot):
		return false
	var keep := core.grow(1.4) if tree else foot.grow(0.15)
	if _hits(keep, ctx.solids) or _hits(core.grow(0.3) if tree else foot, ctx.paved):
		return false
	if _hits(core.grow(0.2) if tree else foot, ctx.blocked):
		return false
	if not overlap and _hits(core.grow(1.6) if tree else foot.grow(0.2), ctx.placed):
		return false
	ctx.placed.append(core.grow(0.4) if tree else foot)
	return true


static func _zone_rect(ctx: _Context, zone: String, rng: RandomNumberGenerator) -> Rect2:
	var l := ctx.lot
	match zone:
		"front":
			return Rect2(l.position.x, ctx.front_z, l.size.x, -ctx.front_z)
		"back":
			return Rect2(l.position.x, l.position.y, l.size.x, ctx.back_z - l.position.y)
		"side":
			if rng.randf() < 0.5:
				return Rect2(l.position.x, ctx.back_z, ctx.side_x0 - l.position.x, ctx.front_z - ctx.back_z)
			return Rect2(ctx.side_x1, ctx.back_z, l.end.x - ctx.side_x1, ctx.front_z - ctx.back_z)
	return l


static func _ground_spot(ctx: _Context, rule: Dictionary, info: Dictionary, rng: RandomNumberGenerator,
		zone: String) -> Variant:
	var spin: bool = info["category"] in SPIN_CATEGORIES and info["id"] != "sea_grape_hedge"
	var yaw := rng.randf() * TAU if spin else rng.randi_range(0, 3) * PI * 0.5
	var pos := Vector3.ZERO
	var l := ctx.lot
	if zone == "wall_foot":
		var w := _pick_wall(ctx, rng, 1)
		if w < 0:
			return null
		var a := Vector2(ctx.walls[w], ctx.walls[w + 1])
		var b := Vector2(ctx.walls[w + 2], ctx.walls[w + 3])
		var n := Vector2(ctx.walls[w + 4], ctx.walls[w + 5])
		var foot: Rect2 = info["foot"]
		var half := foot.size.x * 0.5
		if a.distance_to(b) < foot.size.x + 0.4:
			return null
		var p := a.lerp(b, rng.randf_range((half + 0.2) / a.distance_to(b), 1.0 - (half + 0.2) / a.distance_to(b)))
		p += n * (foot.size.y * 0.5 + 0.15)
		yaw = atan2(n.x, n.y)
		pos = Vector3(p.x, 0, p.y)
	else:
		var foot := _xf_rect(info["foot"] if not info["category"] in TREE_CATEGORIES else info["trunk"],
				Transform3D(Basis(Vector3.UP, yaw), Vector3.ZERO))
		var inset := 0.3
		match zone:
			"front_edge":
				pos = Vector3(rng.randf_range(l.position.x - foot.position.x + inset, l.end.x - foot.end.x - inset),
						0, -foot.end.y - inset - rng.randf() * 0.6)
			"back_edge":
				pos = Vector3(rng.randf_range(l.position.x - foot.position.x + inset, l.end.x - foot.end.x - inset),
						0, l.position.y - foot.position.y + inset + rng.randf() * 0.6)
			"side_edge":
				if info["id"] == "sea_grape_hedge":
					yaw = PI * 0.5
					foot = _xf_rect(info["foot"], Transform3D(Basis(Vector3.UP, yaw), Vector3.ZERO))
				var right := rng.randf() < 0.5
				var x := l.end.x - foot.end.x - inset if right else l.position.x - foot.position.x + inset
				pos = Vector3(x, 0, rng.randf_range(l.position.y - foot.position.y + inset, -foot.end.y - inset))
			_:
				var z := _zone_rect(ctx, zone, rng)
				var x0 := z.position.x - foot.position.x
				var x1 := z.end.x - foot.end.x
				var z0 := z.position.y - foot.position.y
				var z1 := z.end.y - foot.end.y
				if x1 < x0 or z1 < z0:
					return null
				pos = Vector3(rng.randf_range(x0, x1), 0, rng.randf_range(z0, z1))
	var xf := Transform3D(Basis(Vector3.UP, yaw), pos + Vector3(0, 0.02, 0))
	if not _ground_ok(ctx, info, xf, bool(rule.get("overlap", false))):
		return null
	return xf


## Index into ctx.walls of a random wall; front: 1 street faces only, 0 the others, -1 any.
static func _pick_wall(ctx: _Context, rng: RandomNumberGenerator, front: int, min_len := 0.0) -> int:
	var choices: Array[int] = []
	for i in range(0, ctx.walls.size(), 8):
		if front >= 0 and int(ctx.walls[i + 7]) != front:
			continue
		var length := Vector2(ctx.walls[i], ctx.walls[i + 1]).distance_to(Vector2(ctx.walls[i + 2], ctx.walls[i + 3]))
		if length >= min_len:
			choices.append(i)
	return choices[rng.randi_range(0, choices.size() - 1)] if not choices.is_empty() else -1


static func _inside_solid(ctx: _Context, p: Vector2) -> bool:
	for r in ctx.solids:
		if p.x > r.position.x + 0.01 and p.x < r.end.x - 0.01 and p.y > r.position.y + 0.01 and p.y < r.end.y - 0.01:
			return true
	return false


static func _wall_spot(ctx: _Context, rule: Dictionary, info: Dictionary, rng: RandomNumberGenerator,
		back_only: bool) -> Variant:
	var box: AABB = info["aabb"]
	var w := _pick_wall(ctx, rng, 0 if back_only else -1, maxf(float(rule.get("min_wall", 1.2)), box.size.x + 1.2))
	if w < 0:
		return null
	var a := Vector2(ctx.walls[w], ctx.walls[w + 1])
	var b := Vector2(ctx.walls[w + 2], ctx.walls[w + 3])
	var n := Vector2(ctx.walls[w + 4], ctx.walls[w + 5])
	var top := ctx.walls[w + 6]
	var length := a.distance_to(b)
	var half := box.size.x * 0.5 + 0.5
	var p := a.lerp(b, rng.randf_range(half / length, 1.0 - half / length))
	var yr: Array = rule.get("y", [1.5, 2.0])
	var y := rng.randf_range(float(yr[0]), float(yr[1]))
	if y + box.end.y > top - 0.15:
		return null
	for k in [-half, 0.0, half]:
		var tangent := (b - a).normalized()
		if _inside_solid(ctx, p + tangent * k + n * 0.3):
			return null
	if _near_opening(ctx, Vector3(p.x, y, p.y), n, box.size.x * 0.5 + 0.25, box.position.y - 0.2, box.end.y + 0.2):
		return null
	var spot := Vector3(p.x, y, p.y)
	for s in ctx.wall_spots:
		if s.distance_to(spot) < maxf(1.4, box.size.x + 0.4):
			return null
	ctx.wall_spots.append(spot)
	var lift := 0.015 if info["category"] == "decals" else 0.0
	return Transform3D(Basis(Vector3.UP, atan2(n.x, n.y)), spot + Vector3(n.x, 0, n.y) * lift)


static func _near_opening(ctx: _Context, p: Vector3, n: Vector2, half_w: float, y0: float, y1: float) -> bool:
	for i in range(0, ctx.openings.size(), 8):
		var o := Vector3(ctx.openings[i], ctx.openings[i + 1], ctx.openings[i + 2])
		var on := Vector2(ctx.openings[i + 3], ctx.openings[i + 4])
		if on.dot(n) < 0.9 or absf((Vector2(p.x, p.z) - Vector2(o.x, o.z)).dot(n)) > 0.15:
			continue
		var lateral := absf((Vector2(p.x, p.z) - Vector2(o.x, o.z)).dot(Vector2(-n.y, n.x)))
		if lateral > ctx.openings[i + 5] * 0.5 + half_w:
			continue
		var oy0 := o.y - ctx.openings[i + 6] * 0.5
		var oy1 := o.y + ctx.openings[i + 6] * 0.5
		if p.y + y1 > oy0 and p.y + y0 < oy1:
			return true
	return false


static func _window_spot(ctx: _Context, rule: Dictionary, info: Dictionary, rng: RandomNumberGenerator) -> Variant:
	var free: Array[int] = []
	for i in range(0, ctx.openings.size(), 8):
		if int(ctx.openings[i + 7]) == 0 and ctx.openings[i + 5] >= 0.9 and not ctx.used_windows.has(i):
			free.append(i)
	if free.is_empty():
		return null
	var i := free[rng.randi_range(0, free.size() - 1)]
	ctx.used_windows[i] = true
	var n := Vector2(ctx.openings[i + 3], ctx.openings[i + 4])
	var w := ctx.openings[i + 5]
	var h := ctx.openings[i + 6]
	var pos := Vector3(ctx.openings[i], ctx.openings[i + 1], ctx.openings[i + 2])
	var basis := Basis(Vector3.UP, atan2(n.x, n.y))
	if rule.get("fit", false):
		basis = basis * Basis.from_scale(Vector3(w, h, 1))
	else:
		pos.y -= h * 0.5
	return Transform3D(basis, pos)


static func _back_attach(ctx: _Context, rule: Dictionary, info: Dictionary) -> Variant:
	var foot: Rect2 = info["foot"]
	var best := -1
	var best_len := 0.0
	for i in range(0, ctx.walls.size(), 8):
		if ctx.walls[i + 5] > -0.5:
			continue
		var length := absf(ctx.walls[i + 2] - ctx.walls[i])
		if length > best_len:
			best_len = length
			best = i
	if best < 0:
		return null
	var mid := (ctx.walls[best] + ctx.walls[best + 2]) * 0.5
	var x := clampf(mid, ctx.lot.position.x - foot.position.x + 0.3, ctx.lot.end.x - foot.end.x - 0.3)
	var z := ctx.walls[best + 1] - foot.end.y - 0.05
	var xf := Transform3D(Basis.IDENTITY, Vector3(x, 0.02, z))
	var r := _xf_rect(foot, xf)
	if not ctx.lot.encloses(r) or _hits(_shrink(r, -0.02), ctx.solids) or _hits(r, ctx.paved) \
			or _hits(r, ctx.blocked) or _hits(r, ctx.placed):
		return null
	ctx.placed.append(r)
	return xf


static func _build(items: Array, mirrored: bool) -> Node3D:
	var root := Node3D.new()
	root.name = NODE_NAME
	var groups := {}
	var shapes: Array = []
	var log: Array = []
	for item: Dictionary in items:
		var xf: Transform3D = item["transform"]
		if mirrored:
			xf = KitVariant.mirror_transform(xf)
		var info: Dictionary = item["info"]
		for part: Array in info["parts"]:
			var key := [part[0], part[1]]
			if not groups.has(key):
				groups[key] = []
			groups[key].append(xf * (part[2] as Transform3D))
		for shape: Array in info["shapes"]:
			shapes.append([shape[0], xf * (shape[1] as Transform3D)])
		var rect: Rect2 = item["rect"]
		if mirrored and rect.has_area():
			rect = Rect2(-rect.end.x, rect.position.y, rect.size.x, rect.size.y)
		log.append({"prop": info["id"], "mount": info["mount"], "transform": xf, "rect": rect})
	for key: Array in groups:
		var xfs: Array = groups[key]
		var mm := MultiMesh.new()
		mm.transform_format = MultiMesh.TRANSFORM_3D
		mm.mesh = key[0]
		mm.instance_count = xfs.size()
		for i in xfs.size():
			mm.set_instance_transform(i, xfs[i])
		var mmi := MultiMeshInstance3D.new()
		mmi.multimesh = mm
		mmi.material_override = key[1]
		root.add_child(mmi)
	if not shapes.is_empty():
		var body := StaticBody3D.new()
		body.name = "Collision"
		root.add_child(body)
		for s: Array in shapes:
			var cs := CollisionShape3D.new()
			cs.shape = s[0]
			cs.transform = s[1]
			body.add_child(cs)
	root.set_meta("items", log)
	return root
