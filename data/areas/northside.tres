[gd_resource type="Resource" script_class="AreaData" format=3]

[ext_resource type="Script" path="res://scripts/data/territory/area_data.gd" id="1"]
[ext_resource type="Script" path="res://scripts/data/territory/area_bonus_data.gd" id="2"]

[sub_resource type="Resource" id="bonus"]
script = ExtResource("2")
income_multiplier = 1.25
flat_income_per_cycle = 150
respect_reward = 300
unlocks = Array[StringName]([&"northside_control"])

[resource]
script = ExtResource("1")
id = &"northside"
display_name = "Northside"
bonuses = Array[ExtResource("2")]([SubResource("bonus")])
story_beat = &"area_northside_taken"
sort_order = 2
