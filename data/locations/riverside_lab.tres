[gd_resource type="Resource" script_class="LocationDef" format=3]

[ext_resource type="Script" path="res://scripts/framework/core/effect.gd" id="1_eff"]
[ext_resource type="Script" path="res://scripts/framework/interaction/interaction_action.gd" id="2_act"]
[ext_resource type="Script" path="res://scripts/framework/operations/actions/open_site_panel_effect.gd" id="3_osp"]
[ext_resource type="Resource" path="res://data/interiors/small_room.tres" id="4_int"]
[ext_resource type="Script" path="res://scripts/framework/location/location_def.gd" id="5_loc"]

[sub_resource type="Resource" id="Resource_open"]
script = ExtResource("3_osp")
site_id = &"riverside_lab"

[sub_resource type="Resource" id="Resource_manage"]
script = ExtResource("2_act")
verb = "Manage"
priority = 10
effects = Array[ExtResource("1_eff")]([SubResource("Resource_open")])
id = &"manage_riverside_lab"
display_name = "Manage"

[resource]
script = ExtResource("5_loc")
kind = &"lab"
color = Color(0.85, 0.85, 0.95, 1)
interior = ExtResource("4_int")
door_actions = Array[ExtResource("2_act")]([SubResource("Resource_manage")])
door_action_ids = Array[StringName]([&"enter_building"])
unique = true
min_count = 1
spawn_weight = 0.0
district_ids = Array[StringName]([&"riverside"])
extra = {"site_id": &"riverside_lab"}
id = &"riverside_lab"
display_name = "Riverside Lab"
description = "A stash house fitted out to cook coke. Take Riverside to use it."
tags = Array[StringName]([&"operations", &"lab"])