[ext_resource type="Script" path="res://scripts/framework/core/effect.gd" id="6_ggdd4"]
[ext_resource type="Script" path="res://scripts/framework/dialogue/checks/persuade_check.gd" id="7_cfh5q"]
[ext_resource type="Script" path="res://scripts/framework/core/conditions/weapon_drawn_condition.gd" id="8_30m51"]
[ext_resource type="Script" path="res://scripts/framework/dialogue/checks/intimidate_check.gd" id="9_4rtk1"]
[ext_resource type="Script" path="res://scripts/framework/dialogue/effects/disposition_effect.gd" id="10_ent5o"]
[ext_resource type="Script" path="res://scripts/framework/location/effects/intel_effect.gd" id="11_7icqm"]
