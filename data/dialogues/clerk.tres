[ext_resource type="Script" path="res://scripts/framework/location/effects/heat_effect.gd" id="11_pspfm"]
[ext_resource type="Script" path="res://scripts/framework/core/costs/cash_cost.gd" id="12_wcp1n"]
[ext_resource type="Script" path="res://scripts/framework/location/effects/intel_effect.gd" id="13_1hix3"]
[ext_resource type="Script" path="res://scripts/framework/location/effects/rob_location_effect.gd" id="14_w4x8n"]
[ext_resource type="Script" path="res://scripts/framework/core/effects/respect_effect.gd" id="15_o0fg8"]
